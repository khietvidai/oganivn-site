---
import type { ContentEntry, InferCollectionData } from "emdash";

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	tags?: Array<{ slug: string; label: string }>;
	variant?: "card" | "feature" | "row";
	headingLevel?: 2 | 3;
	priority?: boolean;
}

const { post } = Astro.props;
const href = `/${post.id}/`;
const title = post.data.title || "Untitled";
const excerpt = post.data.excerpt
	? post.data.excerpt.length > 125
		? `${post.data.excerpt.slice(0, 125).trim()}...`
		: post.data.excerpt
	: "";
const imageSrc = post.data.featured_image?.src || "";
const imageAlt = post.data.featured_image?.alt || title;
---

<div class="col post-item">
	<div class="col-inner">
		<a href={href} class="plain">
			<div class="box box-text-bottom box-blog-post has-hover">
				{
					imageSrc && (
						<div class="box-image">
							<div class="image-cover" style="padding-top:56%;">
								<img
									width="300"
									height="200"
									src={imageSrc}
									class="attachment-medium size-medium wp-post-image"
									alt={imageAlt}
									decoding="async"
									loading="lazy"
								/>
							</div>
						</div>
					)
				}
				<div class="box-text text-left">
					<div class="box-text-inner blog-post-inner">
						<h3 class="post-title is-large">{title}</h3>
						<div class="is-divider"></div>
						{excerpt && <p class="from_the_blog_excerpt">{excerpt}</p>}
					</div>
				</div>
			</div>
		</a>
	</div>
</div>
