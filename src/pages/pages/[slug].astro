---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const { slug } = Astro.params;
if (!slug) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/${slug}/`,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
}
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={`${Astro.url.origin}/${slug}/`}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<div class="row page-wrapper">
		<div id="content" class="large-12 col">
			<header class="entry-header text-center">
				<h1 class="entry-title">{page.data.title}</h1>
				<div class="is-divider medium"></div>
			</header>
			<div class="entry-content">
				<PortableText value={page.data.content} />
			</div>
		</div>
	</div>
</Base>
