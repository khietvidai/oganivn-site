---
import { search } from "emdash";
import Base from "../layouts/Base.astro";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";

const { items: results } =
	query.length >= 2
		? await search(query, {
				collections: ["posts", "pages", "products"],
				limit: 20,
			})
		: { items: [] };
---

<Base
	title={query ? `Search: ${query} - Ogani` : "Search - Ogani"}
	description="Search articles, pages, and products on Ogani"
	canonical={`${Astro.url.origin}/search`}
>
	<div id="content" class="blog-wrapper blog-archive page-wrapper">
		<header class="archive-page-header">
			<div class="row">
				<div class="large-12 text-center col">
					<h1 class="page-title is-large uppercase">
						{query ? `Search Results for: ${query}` : "Search"}
					</h1>
				</div>
			</div>
		</header>

		<div class="row align-center">
			<div class="large-10 col">
				<form role="search" method="get" class="searchform mb" action="/search">
					<div class="flex-row relative">
						<div class="flex-col flex-grow">
							<input
								type="search"
								class="search-field mb-0"
								placeholder="Enter search keyword..."
								value={query}
								name="q"
							/>
						</div>
						<div class="flex-col">
							<button
								type="submit"
								value="Search"
								class="ux-search-submit submit-button secondary button icon mb-0"
								aria-label="Submit"
							>
								<i class="icon-search"></i>
							</button>
						</div>
					</div>
				</form>

				{
					results.length > 0 ? (
						<div class="row large-columns-3 small-columns-1">
							{results.map((item) => {
								const slugOrId = item.slug ?? item.id;
								const href =
									item.collection === "products"
										? `/product/${slugOrId}/`
										: `/${slugOrId}/`;
								return (
									<div class="col post-item">
										<div class="col-inner">
											<a href={href} class="plain">
												<div class="box box-text-bottom box-blog-post has-hover">
													<div class="box-text text-left">
														<div class="box-text-inner blog-post-inner">
															<h3 class="post-title is-large">{item.title}</h3>
															<div class="is-divider" />
															{item.snippet && (
																<p
																	class="from_the_blog_excerpt"
																	set:html={item.snippet}
																/>
															)}
														</div>
													</div>
												</div>
											</a>
										</div>
									</div>
								);
							})}
						</div>
					) : (
						query.length >= 2 && (
							<p class="text-center">
								No results found for &ldquo;{query}&rdquo;.
							</p>
						)
					)
				}
			</div>
		</div>
	</div>
</Base>
