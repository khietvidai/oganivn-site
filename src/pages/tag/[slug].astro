---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";

const { slug } = Astro.params;
if (!slug) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const termsResult = await getTaxonomyTermsWithCacheHint("tag");
const term = termsResult.data.find((t) => t.slug === slug);
if (!term) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const { entries: posts, cacheHint: postsCacheHint } = await getEmDashCollection(
	"posts",
	{
		where: { tag: slug },
		orderBy: { published_at: "desc" },
		limit: 100,
	},
);

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(postsCacheHint);
}
---

<Base
	title={`${term.label} - Ogani`}
	description={`Posts tagged "${term.label}"`}
	canonical={`${Astro.url.origin}/tag/${slug}`}
	bodyClass={`archive tag tag-${slug} theme-flatsome woocommerce-no-js lightbox nav-dropdown-has-arrow nav-dropdown-has-shadow nav-dropdown-has-border`}
>
	<div id="content" class="blog-wrapper blog-archive page-wrapper">
		<header class="archive-page-header">
			<div class="row">
				<div class="large-12 text-center col">
					<h1 class="page-title is-large uppercase">
						Tag Archives: <span>{term.label}</span>
					</h1>
				</div>
			</div>
		</header>

		<div class="row align-center">
			<div class="large-10 col">
				<div
					class="row large-columns-3 medium-columns-2 small-columns-1 row-masonry"
					data-packery-options='{"itemSelector": ".col", "gutter": 0, "percentPosition": true}'
				>
					{posts.map((post) => <PostCard post={post} />)}
				</div>
			</div>
		</div>
	</div>
</Base>
